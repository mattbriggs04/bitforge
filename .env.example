# Backend (SQLite; paths are relative to backend/)
HTTP_PORT=8080
DATABASE_URL=file:bitforge.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)
DEFAULT_USER_HANDLE=demo
COMPILE_TIMEOUT=20s
RUN_TIMEOUT=3s
JUDGE_WORKERS=2
SANDBOX_IMAGE=bitforge-runner:v1
# Optional Linux runtime, e.g. runsc. Must be installed in Docker's daemon.
SANDBOX_RUNTIME=
BACKEND_API_URL=http://localhost:8080
